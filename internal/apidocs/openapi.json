{
  "openapi": "3.0.3",
  "info": {
    "title": "Fitness Club API",
    "description": "API для управления расписанием групповых занятий фитнес-клуба.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Проверить состояние сервиса",
        "responses": {
          "200": {
            "description": "Сервис работает",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/classes": {
      "get": {
        "summary": "Получить список занятий",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Поиск по части названия без учёта регистра",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Точное название без учёта регистра",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trainer",
            "in": "query",
            "description": "Точное имя тренера без учёта регистра",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список занятий",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Class"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "post": {
        "summary": "Создать занятие",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Занятие создано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Class"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/classes/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ClassID"
        }
      ],
      "get": {
        "summary": "Получить занятие по ID",
        "responses": {
          "200": {
            "description": "Занятие",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Class"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Полностью заменить занятие",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Занятие заменено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Class"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "summary": "Частично изменить занятие",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Занятие изменено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Class"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Удалить занятие",
        "responses": {
          "204": {
            "description": "Занятие удалено"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/classes/stats": {
      "get": {
        "summary": "Получить самые посещаемые занятия",
        "responses": {
          "200": {
            "description": "Занятия с количеством записей",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassStats"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/classes/{id}/signups": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ClassID"
        }
      ],
      "get": {
        "summary": "Получить записи на занятие",
        "responses": {
          "200": {
            "description": "Список записей",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Signup"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "summary": "Записать клиента на занятие",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Запись создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Signup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ClassID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "Class": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ClassInput"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "example": 1
              }
            }
          }
        ]
      },
      "ClassInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "trainer", "starts_at", "capacity"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Йога"
          },
          "trainer": {
            "type": "string",
            "minLength": 1,
            "example": "Анна"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-02T18:30:00+10:00"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example": 15
          }
        }
      },
      "ClassPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "trainer": {
            "type": "string",
            "minLength": 1
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "SignupInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client", "phone"],
        "properties": {
          "client": {
            "type": "string",
            "minLength": 1,
            "example": "Иванов"
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "example": "+79990001122"
          }
        }
      },
      "Signup": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SignupInput"
          },
          {
            "type": "object",
            "required": ["id", "class_id"],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "class_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      "ClassStats": {
        "type": "object",
        "required": ["class_id", "name", "signup_count"],
        "properties": {
          "class_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "signup_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Некорректный запрос",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Занятие не найдено",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Нет свободных мест или клиент уже записан",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
